{
  "type": "object",
  "properties": {
    "device": { "type": "string" },
    "date": { "type": "string" },
    "guideline_summary": {
      "type": "string",
      "description": "주요지침에서 실제로 적용한 비교 규칙을 3문장 이내로 요약"
    },
    "mappings": {
      "type": "array",
      "description": "API 하나당 한 항목. 대응 테스트가 여러 건이면 tests 배열에 모두 담는다.",
      "items": {
        "type": "object",
        "properties": {
          "api_id": { "type": "string", "description": "사양서상 API 식별자 또는 소제목" },
          "api_method": { "type": "string" },
          "api_path": { "type": "string" },
          "api_summary": { "type": "string", "description": "40자 이내 요약" },
          "spec_anchor": { "type": "string", "description": "사양서 내 위치(헤딩 경로 또는 줄 번호)" },
          "tests": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test_id": { "type": "string" },
                "test_title": { "type": "string" },
                "test_anchor": { "type": "string" },
                "confidence": {
                  "type": "string",
                  "enum": ["상", "중", "하"],
                  "description": "상=근거 명확, 중=사람 확인 필요, 하=대응 아닐 가능성 높음"
                },
                "rationale": { "type": "string", "description": "그 등급을 준 근거. 사양서/테스트목록의 실제 문구를 인용." },
                "guideline_refs": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "적용한 주요지침 조항"
                }
              },
              "required": ["test_id", "test_title", "confidence", "rationale"],
              "additionalProperties": false
            }
          }
        },
        "required": ["api_id", "api_method", "api_path", "tests"],
        "additionalProperties": false
      }
    },
    "unmapped_apis": {
      "type": "array",
      "description": "대응 테스트를 찾지 못한 API",
      "items": {
        "type": "object",
        "properties": {
          "api_id": { "type": "string" },
          "api_method": { "type": "string" },
          "api_path": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["api_id", "reason"],
        "additionalProperties": false
      }
    },
    "unmapped_tests": {
      "type": "array",
      "description": "대응 API를 찾지 못한 테스트",
      "items": {
        "type": "object",
        "properties": {
          "test_id": { "type": "string" },
          "test_title": { "type": "string" },
          "reason": { "type": "string" }
        },
        "required": ["test_id", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": ["device", "date", "mappings", "unmapped_apis", "unmapped_tests"],
  "additionalProperties": false
}
