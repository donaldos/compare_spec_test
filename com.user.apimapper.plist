<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.apimapper</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <!-- 실제 설치 경로로 교체 -->
    <string>/Users/USERNAME/api-test-mapper/run_daily.sh</string>
  </array>

  <!-- 매일 08:00. cron과 달리 맥이 자고 있었으면 깨어난 직후 한 번 실행한다. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/api-test-mapper/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/api-test-mapper/logs/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
