# run_daily.sh 설정. 절대경로만 쓸 것 (cron/launchd는 cwd를 보장하지 않는다).

# 감시할 폴더 — 사양서/테스트목록/주요지침이 올라오는 곳
WATCH_DIR="$HOME/Documents/기기문서"

# 엑셀 리포트 출력 폴더
OUT_DIR="$HOME/Documents/기기문서/_리포트"

# claude 실행 파일 경로. `which claude` 결과를 넣는다.
CLAUDE_BIN="$HOME/.local/bin/claude"

# 모델. 판단 품질이 중요하므로 기본은 opus, 비용 우선이면 sonnet.
MODEL="opus"

# API 키를 설정하면 --bare 모드(재현성 우선, 종량 과금)로 동작한다.
# 비워 두면 구독 로그인 자격증명을 사용한다.
# ANTHROPIC_API_KEY="sk-ant-..."

# 세트 1건당 최대 실행 시간(초)
TIMEOUT_SEC=900
